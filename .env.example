# Copy this file to .env and fill in your values. Never commit .env.

# MongoDB Atlas (recommended) - from Atlas: Database > Connect > Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Local MongoDB alternative:
# MONGODB_URI=mongodb://localhost:27017

MONGODB_DB=medikiosk

# Any long random string; generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Default window (days) for "expiring soon" alerts
EXPIRY_SOON_DAYS=30

# Timezone for displaying stock-movement times
DISPLAY_TZ=Asia/Kolkata
